# Frontend image (finding H4: compose previously shipped no product surface —
# no GraphQL, no UI). Builds the Vite SPA and serves it from a non-root nginx
# that proxies /graphql + /health to the graphql-api service, so the browser
# talks to the backend same-origin (no CORS), exactly as the dev proxy does.
#
# Same toolchain and the same LOCKFILE as CI (`bun install --frozen-lockfile`):
# an `npm install` here resolved its own dependency tree, so the image could
# ship versions nothing in CI had ever built or tested (audit round 4, LOW).

FROM oven/bun:1.3-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend/ ./
RUN bun run build

# nginx-unprivileged runs as uid 101 and listens on 8080 — no root, no cap_net.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
