# secrets
.env
secrets/*
keystore.json
bundlr_wallet.json

# rust — bare, so it also covers crates/solana-gate/target (built out of workspace)
target

# old pre-move project root; nothing should live here anymore (moved to repo root)
/bridge/

# node
node_modules/
dist/

# foundry
contracts/out
contracts/cache
contracts/broadcast
# deps are vendored by forge install; keep lib out of git
contracts/lib
contracts/fixtures/swap-deploy.env
contracts/fixtures/xswap-*.env

# postgres data dir for the local compose stack
pgdata/

# a runtime store, never source...
data
# ...but the frontend's src/data is real source (formatters/presentation), not a
# runtime store — the bare `data` rule above would otherwise silently drop it.
!frontend/src/data/
!frontend/src/data/**

# generated at runtime by scripts/testing/*.sh
sig-*
.live-*
/.e2e-logs
/.xswap-logs
/.swap-logs
/.refund-e2e-logs
/validator.toml
/validator-p6.toml
/val1-p7.toml
/val2-p7.toml
/val3-p7.toml
/val1-gql.toml
/val2-gql.toml
/keeper.toml
/keeper-p7.toml
/keeper-gql.toml
# generated by scripts/testing/refund-relayer-e2e.sh
/indexer-refund.toml
/keeper-refund.toml
/validator-refund.toml
/validator-state.json
*.json.tmp
*.log
# scripts/run.sh — frontend env override (if written) and local config copies.
# `*.config.local` covers the testnet configs too: those carry real private keys
# for real (if valueless) chains, and must never be committed.
frontend/.env.local
scripts/run.config.local
scripts/*.config.local

# Solana keypair files for the devnet leg — real ed25519 private keys.
.solana/

# editors, tooling, OS
.vs/
.idea/*
.cache
.local
.claude
.playwright-mcp
.DS_Store
heap_info.json

# Docker-side cargo/rustup caches from the Solana toolchain image
# (scripts/testing/solana-onchain.sh mounts the repo into the container).
.docker-cargo/
.docker-rustup/

# JSON configs holding real keys / API endpoints (mirrors scripts/*.config.local)
config/*.local.json
# Deploy records: generated, and they carry the RPC URLs (API keys) they used.
config/deployments/*.json

# Generated docker stacks (`bridge-from-json.sh --compose`): the configs inside
# carry validator/keeper keys, and the compose file itself used to inline keyed
# RPC URLs (H-4, audit round 4) — it is generated output, never source. Only
# `.env.example` in a generated stack is committable.
docker/*/configs/
docker/*/.env
docker/*/keys/
docker/*/docker-compose.yml

# Production stacks (docker/production/<role>/): the templates are tracked, the
# filled-in copies never are. A real .env holds the sig-store tokens and the DB
# password; a real config holds RPC URLs with API keys; secrets/ holds keystores.
docker/production/*/.env
docker/production/*/configs/*
!docker/production/*/configs/*.example
docker/production/*/secrets/*
!docker/production/*/secrets/README.md
