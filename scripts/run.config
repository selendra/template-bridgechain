# run.config — configuration for scripts/run.sh (the bridge + swap launcher).
#
# This file is sourced as bash, so it's `KEY=value` (quote things with spaces).
# The defaults below bring up a complete LOCAL stack on two anvil chains with
# well-known public test keys — edit for your own chains/keys/ports.
#
#   bash scripts/run.sh            # uses this file
#   bash scripts/run.sh my.config  # uses a different config file
#   bash scripts/stop.sh           # tears the stack down (reads the same file)

# ---------------------------------------------------------------------------
# Toolchain — where node/npm, foundry (anvil/cast/forge) and cargo live.
# Auto-detected if left as-is; override only if yours are elsewhere.
# ---------------------------------------------------------------------------
NODE_BIN=""                       # e.g. "$HOME/.nvm/versions/node/v24.18.0/bin"; empty = auto-detect
FOUNDRY_BIN="$HOME/.foundry/bin"
CARGO_BIN="$HOME/.cargo/bin"

# ---------------------------------------------------------------------------
# Chains — list as MANY as you want (2, 3, 4, …). Each chain runs ONE Gate that
# bridges to every other chain's Gate (full mesh, both directions).
#
# Entry format (pipe-separated fields — no brackets, that's just notation):
#
#   DEPLOY_BRIDGE=true  (deploy fresh Gates) : "chain_id|name|rpc_url"          <- 3 fields
#   DEPLOY_BRIDGE=false (existing Gates)     : "chain_id|name|rpc_url|gate"     <- 4 fields
#
# `gate` is the deployed 0x… Gate address, needed only when DEPLOY_BRIDGE=false.
# (Tokens are NOT listed here — they're per-asset, see ASSETS below.)
# With LOCAL_ANVIL=true an anvil is booted per chain on the RPC's port.
# ---------------------------------------------------------------------------
LOCAL_ANVIL=true

# Seconds between blocks on those local anvils. Must stay > 0: a default anvil
# mines only on a transaction, which freezes the head timestamp and silently
# disables everything timed in block time — the refund path above all (see the
# comment at the anvil launch in run.sh). Raise it to model a slower chain.
ANVIL_BLOCK_TIME=1

CHAINS=(
  "1337|Anvil A|http://127.0.0.1:8545"
  "1338|Anvil B|http://127.0.0.1:8546"
  # "1339|Anvil C|http://127.0.0.1:8547"
  # existing-Gate example (DEPLOY_BRIDGE=false): "1|Ethereum|https://eth.rpc|0xGate…"
)

# ---------------------------------------------------------------------------
# Assets — the tokens that can be bridged. List as MANY as you want; each chain
# can carry SEVERAL. An asset is wired full-mesh across the chains it lists.
#
#   "SYMBOL | chain_id:token | chain_id:token | ..."
#   token = "auto" to deploy a fresh TestToken (needs DEPLOY_TOKENS=true),
#           or an existing 0x… address (that token on that chain).
#
# An asset need not exist on every chain — it bridges only between the chains it
# lists. The FIRST asset present on a chain is the one the demo UI shows for it.
# ---------------------------------------------------------------------------
ASSETS=(
  "TST|1337:auto|1338:auto"
  # a second bridgeable token on the same chains:
  # "USDC|1337:auto|1338:auto"
  # existing-token example: "USDC|1:0xA0b8...|137:0x2791..."
)

# ---------------------------------------------------------------------------
# What to deploy (each independent). true = create fresh + wire; false = reuse
# the addresses you supplied (CHAINS `gate`, ASSETS 0x tokens, SWAP_POOL_ADDR).
# ---------------------------------------------------------------------------
DEPLOY_TOKENS=true                # deploy the ASSETS marked "auto"
DEPLOY_BRIDGE=true                # deploy Gates + register/liquidity-wire every asset's mesh
DEPLOY_SWAP=true                  # deploy the same-chain SwapPool (Swap view)

# Which chain hosts the same-chain SwapPool for the Swap view (a chain_id from
# CHAINS). Defaults to the first chain if unset.
SWAP_CHAIN=1337
SWAP_POOL_ADDR=""                 # used only when DEPLOY_SWAP=false

# ---------------------------------------------------------------------------
# Keys (PUBLIC anvil dev keys — test only; NEVER use these on a real network).
# The validator set is exactly VALIDATOR_KEYS; THRESHOLD signatures are required.
# Addresses are derived from the keys automatically.
# VALIDATOR_KEYS are bridge secure key (offchain sig) and KEEPER_KEY is verify key use to send signatures to chain (on chain)
# ---------------------------------------------------------------------------
DEPLOYER_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
VALIDATOR_KEYS=(
  "0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"  # anvil[1]
  "0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a"  # anvil[2]
)
THRESHOLD=2
KEEPER_KEY="0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a"  # anvil[4]

# ---------------------------------------------------------------------------
# Features — turn subsystems on/off.
# ---------------------------------------------------------------------------
ENABLE_SWAP=true                  # deploy a SwapPool on SRC + serve the Swap view
ENABLE_INDEXER=true               # run the indexer (transaction history + refund eligibility)
ENABLE_REFUND=true                # run the two-phase refund path (validator loop + keeper)

# Refund tuning (only used when ENABLE_REFUND=true).
REFUND_TIMEOUT_SECS=30            # a transfer is "stuck" after this long unclaimed
SWEEP_INTERVAL_SECS=5             # how often the indexer re-checks eligibility
# Finality buffer for SOURCE scanning (validators + indexer). On a REAL chain this
# MUST exceed the chain's reorg depth: signing a Sent event at the tip lets a reorg
# erase the deposit after the destination was paid (double-spend). The validator
# now refuses to start with a 0 buffer unless the opt-out below is set. anvil is
# instant-final, so 0 + the opt-out is safe locally ONLY.
SOURCE_BLOCK_CONFIRMATION=0
SOURCE_ALLOW_ZERO_CONFIRMATION=true   # set false + a real buffer on a real chain
# Same, for refund DESTINATION reads (a reorg after a signed refund = double-spend).
REFUND_BLOCK_CONFIRMATION=0   #999
REFUND_ALLOW_ZERO_CONFIRMATION=true   # set false + a real buffer on a real chain

# ---------------------------------------------------------------------------
# Ports / binds.
# ---------------------------------------------------------------------------
STORE_PORT=8080                   # sig-store HTTP
GQL_PORT=8088                     # graphql-api
WEB_PORT=5173                     # frontend (vite)
BIND_HOST=127.0.0.1               # host to bind services to
WEB_HOST=127.0.0.1                # 0.0.0.0 to expose the UI on your LAN

# ---------------------------------------------------------------------------
# Postgres (required — the sig-store and indexer are Postgres-backed).
# Runs in Docker by default. To use your own Postgres set PG_DOCKER=false and
# point DATABASE_URL at it.
# ---------------------------------------------------------------------------
PG_DOCKER=true
PG_NAME="bridge-run-pg"
PG_PORT=5433
DATABASE_URL="postgres://bridge:bridge@127.0.0.1:5433/bridge?sslmode=disable"

# Where logs and generated configs go.
RUN_DIR="/tmp/bridge-run"
